# Base URL for Nazarje Dogodki API (no trailing slash)
# Produkcija (Vercel): https://api.nazarje.si
VITE_API_URL=https://api.nazarje.si

# Public site URL (canonical, OG, sitemap)
VITE_SITE_URL=https://dogodki.nazarje.si

# Default OG image (absolute URL or path on site)
# VITE_OG_DEFAULT_IMAGE=https://dogodki.nazarje.si/og-default.jpg

# Footer / social links (leave empty to hide FB/IG)
# VITE_FACEBOOK_URL=https://www.facebook.com/...
# VITE_INSTAGRAM_URL=https://www.instagram.com/...
VITE_OBCINA_URL=https://www.nazarje.si

# Lokalno: npm run dev uporabi .env.development z VITE_API_URL=/api (Vite proxy → api.nazarje.si).
# Če v .env ročno nastaviš https://api.nazarje.si, lahko pride do CORS na admin potih.

# Set to "true" to use local seed data instead of API (development only)
# VITE_USE_MOCK=true
